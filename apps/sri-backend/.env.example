# =====================================================================
# UALDO NEGOCIOS / SRI BACKEND - CONFIGURACION DE ENTORNO
# =====================================================================

PORT=3001

# Ambiente SRI: '1' para Pruebas / Certificacion | '2' para Produccion Oficial
SRI_AMBIENTE=2

# Requerir base de datos obligatoria (Fail-Fast Fiscal)
# En ambiente='2' debe ser true para impedir emisiones huerfanas en memoria
SRI_REQUIRE_DB=true

# RUC del emisor farmaceutico (13 digitos)
SRI_RUC_EMISOR=1790016919001

# Certificado digital .p12 y contrasena (NUNCA SUBIR A GIT)
# Opcion A: Ruta local al archivo .p12 (ej. en VPS o montaje /etc/secrets)
SRI_P12_PATH=/etc/secrets/firma_electronica_produccion.p12
# Opcion B: Contenido del archivo .p12 codificado en Base64 (ideal para Coolify, Render, Railway)
SRI_P12_BASE64=
# Contrasena del certificado digital .p12
SRI_P12_PASSWORD=su_clave_segura_de_firma

# Credenciales de Base de Datos PostgreSQL (driver pg)
# Opcion A: Cadena de conexion completa (Recomendada para Coolify o Postgres gestionado)
DATABASE_URL=postgresql://usuario_app:clave_segura@postgres:5432/ualdo_negocios
# Opcion B: Variables discretas
# PGHOST=postgres
# PGPORT=5432
# PGUSER=usuario_app
# PGPASSWORD=clave_segura
# PGDATABASE=ualdo_negocios
# SSL opcional: 'require' para Postgres gestionado en la nube; omitir para Postgres interno en Coolify
# PGSSL=require
# Limite maximo de conexiones en el pool (default: 10)
# PGMAX_CONNECTIONS=10

# Autenticacion y CORS
POS_API_KEY=su_clave_secreta_api_backend_minimo_32_caracteres
JWT_SECRET=su_clave_secreta_jwt_minimo_32_caracteres
FRONTEND_URL=https://negocios.ualdocorp.com

# Servicio de Correo SMTP (para envio automatico de XML + RIDE PDF al autorizar)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=facturacion@farmacia.com
SMTP_PASS=app_password_o_clave_smtp
SMTP_FROM=facturacion@farmacia.com

# Intervalo del Worker en segundos (procesa cola de reintentos 24/7)
SRI_QUEUE_INTERVAL_SEC=5
