# =====================================================================
# PHARMASTOCK SRI BACKEND — CONFIGURACIÓN DE ENTORNO
# =====================================================================

PORT=3001

# Ambiente SRI: '1' para Pruebas / Certificación | '2' para Producción Oficial
SRI_AMBIENTE=2

# Requerir base de datos obligatoria (Fail-Fast Fiscal)
# En ambiente='2' debe ser true para impedir emisiones huérfanas en memoria
SRI_REQUIRE_DB=true

# RUC del emisor farmacéutico (13 dígitos)
SRI_RUC_EMISOR=1790016919001

# Certificado digital .p12 y contraseña (NUNCA SUBIR A GIT)
# Opción A: Ruta local al archivo .p12 (ej. en VPS o montaje /etc/secrets)
SRI_P12_PATH=/etc/secrets/firma_electronica_produccion.p12
# Opción B: Contenido del archivo .p12 codificado en Base64 (ideal para Render, Railway, Fly.io)
SRI_P12_BASE64=
# Contraseña del certificado digital .p12
SRI_P12_PASSWORD=su_clave_segura_de_firma

# Credenciales de Base de Datos y Supabase (Acceso Seguro Backend service_role)
SUPABASE_URL=https://su-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=su_clave_secreta_service_role

# Autenticacion y CORS
POS_API_KEY=su_clave_secreta_api_backend_minimo_32_caracteres
JWT_SECRET=su_clave_secreta_jwt_minimo_32_caracteres
FRONTEND_URL=https://pharmastock.netlify.app

# Servicio de Correo SMTP (para envío automático de XML + RIDE PDF al autorizar)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=facturacion@farmacia.com
SMTP_PASS=app_password_o_clave_smtp
SMTP_FROM=facturacion@farmacia.com

# Intervalo del Worker en segundos (procesa cola de reintentos 24/7)
SRI_QUEUE_INTERVAL_SEC=5
