# =====================================================================
# PHARMASTOCK SRI BACKEND — CONFIGURACIÓN DE ENTORNO
# =====================================================================

PORT=3001

# Ambiente SRI: '1' para Pruebas / Certificación | '2' para Producción Oficial
SRI_AMBIENTE=2

# Requerir base de datos obligatoria (Fail-Fast Fiscal)
# En ambiente='2' debe ser true para impedir emisiones huérfanas en memoria
SRI_REQUIRE_DB=true

# Ruta al certificado digital .p12 y contraseña (NUNCA SUBIR A GIT)
SRI_P12_PATH=/etc/secrets/firma_electronica_produccion.p12
SRI_P12_PASSWORD=su_clave_segura_de_firma

# Credenciales de Base de Datos y Supabase (Acceso Seguro Backend service_role)
SUPABASE_URL=https://su-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=su_clave_secreta_service_role

# Autenticación y CORS
POS_API_KEY=pharmastock-pos-secure-key-2026
FRONTEND_URL=https://pharmastock.netlify.app
