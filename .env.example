# Credenciales de Supabase para la sincronización en la nube.
# 1. Copia este archivo como  .env
# 2. Pega los valores de tu proyecto (Supabase > Project Settings > Data API / API Keys)
# 3. Reinicia el servidor de desarrollo (npm run dev)
#
# Si dejas estos valores vacíos, la app funciona igual pero solo con
# almacenamiento local (localStorage), sin sincronización entre dispositivos.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_ANON_PUBLICA
