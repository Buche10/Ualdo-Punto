# ==============================================================================
# UALDO NEGOCIOS POS — TERMINAL PUNTO DE VENTA (PRODUCTION DOCKERFILE)
# Multi-stage build: Node.js 22 Alpine (Builder) + Nginx Alpine (Runner)
# ==============================================================================

# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /app

# Copiar manifiestos
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY apps/pos-web/package*.json ./apps/pos-web/

# Instalar dependencias limpias
RUN npm ci

# Copiar código fuente
COPY packages/shared ./packages/shared
COPY apps/pos-web ./apps/pos-web

# Variables de entorno en tiempo de compilación (Vite)
ARG VITE_API_URL=https://api-sri.negocios.ualdocorp.com/api
ARG VITE_API_KEY=pharmastock-pos-secure-key-2026
ARG VITE_SUPABASE_URL=https://celuahrpipciaggibhsg.supabase.co
ARG VITE_SUPABASE_ANON_KEY=sb_publishable_Rn6chZOPBM3Z43gqEnJHfg_jSwd5txG

ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_API_KEY=${VITE_API_KEY}
ENV VITE_SUPABASE_URL=${VITE_SUPABASE_URL}
ENV VITE_SUPABASE_ANON_KEY=${VITE_SUPABASE_ANON_KEY}

# Compilar paquetes
RUN npm run build --workspace=@pharmastock/shared
RUN npm run build --workspace=@pharmastock/pos-web

# Stage 2: Production Nginx Server
FROM nginx:alpine AS runner

COPY --from=builder /app/apps/pos-web/dist /usr/share/nginx/html
COPY apps/pos-web/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
